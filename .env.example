# ---------------------------------------------------------------------------
# Environment template. Copy to .env for local development.
#
#   cp .env.example .env
#
# .env is git-ignored and read only as a developer convenience: real environment
# variables always win over it, so it can never override a deployment.
#
# Naming: NEXUSAI_ prefix, double underscore for nesting.
#   NEXUSAI_LOGGING__CONSOLE__LEVEL  ->  logging.console.level
#
# Secrets belong here and only here. They are never written to a YAML file, never
# logged, and never included in a report.
# ---------------------------------------------------------------------------

# local | ci | staging | production
NEXUSAI_ENVIRONMENT=local

# TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
NEXUSAI_LOGGING__LEVEL=INFO
NEXUSAI_LOGGING__CONSOLE__FORMAT=console

# Enable durable JSON logs on disk.
# NEXUSAI_LOGGING__FILE__ENABLED=true

# Where the framework writes data, artefacts, reports, logs and state.
# NEXUSAI_PATHS__ROOT=./.nexusai

# Abort startup if any plugin fails to load. Recommended in production.
# NEXUSAI_PLUGINS__FAIL_ON_LOAD_ERROR=true
